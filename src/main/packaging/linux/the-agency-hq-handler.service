#
# Per-user systemd unit for the Handler daemon. install.sh stamps %HOME% with the real home directory and writes
# the unit into $XDG_CONFIG_HOME/systemd/user (~/.config when unset), then enables it.
[Unit]
Description=The Agency Handler daemon

[Service]
ExecStart=%HOME%/.local/lib/the-agency-hq/handler/bin/handler daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
