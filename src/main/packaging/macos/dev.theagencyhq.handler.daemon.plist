<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Per-user LaunchAgent for the Handler daemon. KeepAlive on SuccessfulExit=false matches the daemon's exit-code
     contract: a non-zero exit is a failure launchd should restart, a zero exit is a clean shutdown. launchd does
     not expand ~, so %HOME% is stamped with the real home directory by the pkg postinstall. -->
<dict>
  <key>Label</key>
  <string>dev.theagencyhq.handler.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>%HOME%/Applications/The Agency Handler.app/Contents/Resources/daemon/bin/handler</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
