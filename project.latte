project(group: "dev.theagencyhq", name: "handler", version: "0.1.7", licenses: ["MIT"]) {
  workflow {
    standard()
  }
  publishWorkflow {
    latte()
  }

  dependencies {
    group(name: "compile-processors") {
      dependency(id: "org.lattejava:json:0.4.3")
    }
    group(name: "compile") {
      dependency(id: "org.lattejava:http:0.3.0")
      dependency(id: "org.lattejava:jwt:0.2.0")
      dependency(id: "org.lattejava:version:0.6.2")
    }
    group(name: "test-compile", export: false) {
      dependency(id: "org.testng:testng:7.10.2")
    }
  }

  publications {
    standard()
  }
}

// Plugins
dependency = loadPlugin(id: "org.lattejava.plugin:dependency:0.6.0")
file = loadPlugin(id: "org.lattejava.plugin:file:0.6.0")
idea = loadPlugin(id: "org.lattejava.plugin:idea:0.6.1")
java = loadPlugin(id: "org.lattejava.plugin:java:0.6.0")
javaTestNG = loadPlugin(id: "org.lattejava.plugin:java-testng:0.6.0")
release = loadPlugin(id: "org.lattejava.plugin:release-git:0.6.0")

// Plugin settings
java.settings.javaVersion = "25"
javaTestNG.settings.javaVersion = "25"

target(name: "clean", description: "Cleans the project") {
  java.clean()
}

target(name: "build", description: "Compiles and JARs the project") {
  java.compile()
  java.jar()
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["build"]) {
  javaTestNG.test()
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test"]) {
  dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
  release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
  idea.iml()
}

target(name: "print-dependency-tree", description: "Prints the dependency tree") {
  dependency.printFull()
}

target(name: "run", description: "Runs the Handler in the foreground", dependsOn: ["build"]) {
  java.run(main: "dev.theagencyhq.handler.Main")
}

// Cross-platform bundling. Each entry maps a Go platform key to the Adoptium API platform names used to fetch
// the Temurin jmods that jlink cross-links the bundled runtime from.
bundleJDKs = [
  "darwin-amd64" : [os: "mac", arch: "x64"],
  "darwin-arm64" : [os: "mac", arch: "aarch64"],
  "linux-amd64"  : [os: "linux", arch: "x64"],
  "linux-arm64"  : [os: "linux", arch: "aarch64"]
]

// Cross-compiles the tray and links the target platform's Java runtime. The tray is pure Go (no cgo), so every
// platform builds from any host; build-jre.sh caches the downloaded jmods under build/jdks.
bundlePrepare = { String goos, String goarch ->
  def key = goos + "-" + goarch
  def jdk = bundleJDKs[key]
  file.mkdir(dir: "build/bundle/tray/" + key)
  file.execute(cmd: ["env", "CGO_ENABLED=0", "GOOS=" + goos, "GOARCH=" + goarch,
                     "go", "build", "-C", "src/main/go", "-trimpath", "-ldflags", "-s -w",
                     "-o", "../../../build/bundle/tray/" + key + "/handler-tray", "."])
  file.execute(cmd: ["bash", "src/main/packaging/build-jre.sh", goos, goarch, jdk.os, jdk.arch])
}

target(name: "bundle", description: "Builds the tray, the bundled runtimes, and every platform installer into build/bundle/out", dependsOn: ["build"]) {
  file.execute(cmd: ["bash", "src/main/packaging/preflight.sh"])

  // Stage the daemon's jars once; every platform package copies from here and build-jre.sh runs jdeps over it
  file.prune(dir: "build/bundle/lib")
  file.mkdir(dir: "build/bundle/lib")
  file.copyFile(file: "build/jars/${project.name}-${project.version}.jar", to: "build/bundle/lib/${project.name}-${project.version}.jar")
  dependency.copy(to: "build/bundle/lib") {
    dependencies(group: "compile", transitive: true, fetchSource: false)
  }

  def version = project.version.toString()
  ["arm64", "amd64"].each { arch ->
    bundlePrepare("darwin", arch)
    file.execute(cmd: ["bash", "src/main/packaging/package-macos.sh", version, arch])
  }

  ["amd64", "arm64"].each { arch ->
    bundlePrepare("linux", arch)
    file.execute(cmd: ["bash", "src/main/packaging/package-linux.sh", version, arch])
  }
}
